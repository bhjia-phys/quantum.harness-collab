{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-architecture-freeze-readback-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "freeze_revision",
    "readback_revision",
    "architecture_freeze",
    "selected_capacity",
    "checkpoint_count",
    "slurm",
    "gates",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "challenge-15-route-d-plus-architecture-freeze-readback-v1"
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "freeze_revision": {"$ref": "#/$defs/revision"},
    "readback_revision": {"$ref": "#/$defs/revision"},
    "architecture_freeze": {"$ref": "#/$defs/artifact"},
    "selected_capacity": {"const": "D+0"},
    "checkpoint_count": {"const": 3},
    "slurm": {"$ref": "#/$defs/slurm"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze_schema_valid",
        "freeze_hash_valid",
        "selection_aggregate_hash_valid",
        "selection_protocol_hash_valid",
        "architecture_hash_valid",
        "exact_three_checkpoint_set",
        "all_checkpoint_hashes_valid",
        "phase7_dplus0_sufficient",
        "remediation_hashes_valid",
        "science_gate_and_readback_passed",
        "heldout_not_accessed",
        "beyond_ed_not_accessed",
        "clean_readback_revision",
        "gpu_slurm_evidence"
      ],
      "properties": {
        "freeze_schema_valid": {"const": true},
        "freeze_hash_valid": {"const": true},
        "selection_aggregate_hash_valid": {"const": true},
        "selection_protocol_hash_valid": {"const": true},
        "architecture_hash_valid": {"const": true},
        "exact_three_checkpoint_set": {"const": true},
        "all_checkpoint_hashes_valid": {"const": true},
        "phase7_dplus0_sufficient": {"const": true},
        "remediation_hashes_valid": {"const": true},
        "science_gate_and_readback_passed": {"const": true},
        "heldout_not_accessed": {"const": true},
        "beyond_ed_not_accessed": {"const": true},
        "clean_readback_revision": {"const": true},
        "gpu_slurm_evidence": {"const": true}
      }
    },
    "passed": {"const": true}
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 2},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "cluster_name",
        "node_list",
        "partition",
        "gpu_devices"
      ],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "cluster_name": {"type": "string", "minLength": 1},
        "node_list": {"type": "string", "minLength": 1},
        "partition": {"type": "string", "minLength": 1},
        "gpu_devices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
