{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-remediation-science-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "producer_revision",
    "verifier_revision",
    "remediation_certificate",
    "remediation_readback",
    "thresholds",
    "seed_summaries",
    "slurm",
    "gates",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "challenge-15-route-d-plus-remediation-science-v1"
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "producer_revision": {"$ref": "#/$defs/revision"},
    "verifier_revision": {"$ref": "#/$defs/revision"},
    "remediation_certificate": {"$ref": "#/$defs/artifact"},
    "remediation_readback": {"$ref": "#/$defs/artifact"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correction_acceptance_min",
        "correction_acceptance_max",
        "mother_acceptance_min",
        "mother_acceptance_max",
        "effective_sample_size_min",
        "r_hat_max_exclusive",
        "gap_standard_error_max",
        "seed_consistency_sigma",
        "rotation_residual_max_exclusive"
      ],
      "properties": {
        "correction_acceptance_min": {"const": 0.05},
        "correction_acceptance_max": {"const": 1.0},
        "mother_acceptance_min": {"const": 0.25},
        "mother_acceptance_max": {"const": 0.70},
        "effective_sample_size_min": {"const": 32.0},
        "r_hat_max_exclusive": {"const": 1.2},
        "gap_standard_error_max": {"const": 0.005},
        "seed_consistency_sigma": {"const": 3.0},
        "rotation_residual_max_exclusive": {"const": 1e-7}
      }
    },
    "seed_summaries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/seed_summary"}
    },
    "slurm": {"$ref": "#/$defs/slurm"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finite_statistics",
        "sampling_acceptance",
        "effective_samples",
        "gap_precision",
        "three_seed_consistency",
        "rotation_invariance",
        "all_seed_training_gates",
        "immutable_checkpoint_hashes",
        "clean_verifier_revision",
        "gpu_slurm_evidence",
        "no_ed_gradient",
        "no_ed_checkpoint_selection"
      ],
      "properties": {
        "finite_statistics": {"type": "boolean"},
        "sampling_acceptance": {"type": "boolean"},
        "effective_samples": {"type": "boolean"},
        "gap_precision": {"type": "boolean"},
        "three_seed_consistency": {"type": "boolean"},
        "rotation_invariance": {"type": "boolean"},
        "all_seed_training_gates": {"type": "boolean"},
        "immutable_checkpoint_hashes": {"type": "boolean"},
        "clean_verifier_revision": {"const": true},
        "gpu_slurm_evidence": {"const": true},
        "no_ed_gradient": {"const": true},
        "no_ed_checkpoint_selection": {"const": true}
      }
    },
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 2},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "standard_error",
        "effective_sample_size",
        "ess_per_second",
        "r_hat",
        "per_chain_correction_acceptance",
        "per_chain_mother_acceptance",
        "global_rotation_residual"
      ],
      "properties": {
        "mean": {"type": "number"},
        "standard_error": {"type": "number", "exclusiveMinimum": 0},
        "effective_sample_size": {"type": "number", "exclusiveMinimum": 0},
        "ess_per_second": {"type": "number", "exclusiveMinimum": 0},
        "r_hat": {"type": "number", "exclusiveMinimum": 0},
        "per_chain_correction_acceptance": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "per_chain_mother_acceptance": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "global_rotation_residual": {"type": "number", "minimum": 0}
      }
    },
    "seed_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "result",
        "checkpoint",
        "gap",
        "gap_standard_error",
        "ground",
        "tower"
      ],
      "properties": {
        "seed": {"enum": [848, 1848, 2848]},
        "result": {"$ref": "#/$defs/artifact"},
        "checkpoint": {"$ref": "#/$defs/artifact"},
        "gap": {"type": "number"},
        "gap_standard_error": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ground": {"$ref": "#/$defs/sector"},
        "tower": {"$ref": "#/$defs/sector"}
      }
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "cluster_name",
        "node_list",
        "partition",
        "gpu_devices"
      ],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "cluster_name": {"type": "string", "minLength": 1},
        "node_list": {"type": "string", "minLength": 1},
        "partition": {"type": "string", "minLength": 1},
        "gpu_devices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
