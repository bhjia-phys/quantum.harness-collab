{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-scalable-calibration-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "source_revision",
    "n_electrons",
    "two_q",
    "architecture_freeze",
    "frozen_architecture",
    "size_architecture",
    "frozen_capacity",
    "frozen_generator_dimension",
    "size_generator_dimension",
    "structural_selection_performed",
    "ed_accessed",
    "heldout_or_beyond_used_for_structure_selection",
    "slurm",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "challenge-15-route-d-plus-scalable-calibration-v1"
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "n_electrons": {"type": "integer", "minimum": 7},
    "two_q": {"type": "integer", "minimum": 18},
    "architecture_freeze": {"$ref": "#/$defs/artifact"},
    "frozen_architecture": {"$ref": "#/$defs/artifact"},
    "size_architecture": {"$ref": "#/$defs/artifact"},
    "frozen_capacity": {"const": "D+0"},
    "frozen_generator_dimension": {"type": "integer", "minimum": 1, "maximum": 3},
    "size_generator_dimension": {"type": "integer", "minimum": 1, "maximum": 3},
    "structural_selection_performed": {"const": false},
    "ed_accessed": {"const": false},
    "heldout_or_beyond_used_for_structure_selection": {"const": false},
    "slurm": {"$ref": "#/$defs/slurm"},
    "passed": {"const": true}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 2},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "cluster", "cuda_visible_devices"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "cuda_visible_devices": {"type": "string", "minLength": 1}
      }
    }
  }
}
