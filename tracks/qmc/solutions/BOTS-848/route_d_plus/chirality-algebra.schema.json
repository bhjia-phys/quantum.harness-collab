{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-chirality-algebra-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "source_revision",
    "clean_worktree",
    "slurm",
    "ed_accessed",
    "systems",
    "gates",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "challenge-15-route-d-plus-chirality-algebra-v1"
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "clean_worktree": {"const": true},
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "cluster", "cuda_visible_devices"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "cuda_visible_devices": {"type": "string", "minLength": 1}
      }
    },
    "ed_accessed": {"const": false},
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "two_q",
          "pair_dimension",
          "allowed_total_j",
          "allowed_relative_r",
          "phase_convention",
          "residuals",
          "allowed_transition_norms",
          "gates",
          "passed"
        ],
        "properties": {
          "two_q": {"type": "integer", "minimum": 2},
          "pair_dimension": {"type": "integer", "minimum": 1},
          "allowed_total_j": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "allowed_relative_r": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "phase_convention": {"type": "object"},
          "residuals": {"type": "object"},
          "allowed_transition_norms": {"type": "object"},
          "gates": {
            "type": "object",
            "minProperties": 6,
            "additionalProperties": {"const": true}
          },
          "passed": {"const": true}
        }
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"const": true}
    },
    "passed": {"const": true}
  }
}
