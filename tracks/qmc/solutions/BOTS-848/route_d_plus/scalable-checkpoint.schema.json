{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-scalable-checkpoint-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seed",
    "n_electrons",
    "two_q",
    "raw_generator_ranks",
    "architecture_sha256",
    "source_revision",
    "proposal_adaptation",
    "ground_delta_maxima",
    "tower_delta_maxima",
    "ground_coefficients",
    "tower_coefficients",
    "initialization_norm",
    "updates",
    "chains",
    "samples_per_update",
    "proposal_sweeps",
    "final_samples_per_chain",
    "checkpoint_selection"
  ],
  "properties": {
    "seed": {"type": "integer", "minimum": 0},
    "n_electrons": {"type": "integer", "minimum": 7},
    "two_q": {"type": "integer", "minimum": 18},
    "raw_generator_ranks": {
      "type": "array",
      "prefixItems": [{"const": 2}, {"const": 3}, {"const": 4}],
      "items": false
    },
    "architecture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proposal_adaptation": {
      "const": "burn-in-only-target-0.35-0.60-frozen-before-training"
    },
    "ground_delta_maxima": {"$ref": "#/$defs/deltas"},
    "tower_delta_maxima": {"$ref": "#/$defs/deltas"},
    "ground_coefficients": {"$ref": "#/$defs/complex_vector"},
    "tower_coefficients": {"$ref": "#/$defs/complex_vector"},
    "initialization_norm": {"type": "number", "exclusiveMinimum": 0},
    "updates": {"type": "integer", "minimum": 1},
    "chains": {"type": "integer", "minimum": 2},
    "samples_per_update": {"type": "integer", "minimum": 2},
    "proposal_sweeps": {"type": "integer", "minimum": 1},
    "final_samples_per_chain": {"type": "integer", "minimum": 32},
    "checkpoint_selection": {"const": "final-update-no-ed-postfreeze"}
  },
  "$defs": {
    "deltas": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "complex_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real", "imag"],
      "properties": {
        "real": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "number"}},
        "imag": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "number"}}
      }
    }
  }
}
