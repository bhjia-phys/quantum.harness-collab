{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-scalable-seed-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "source_revision",
    "n_electrons",
    "two_q",
    "seed",
    "architecture_freeze",
    "calibration",
    "size_architecture",
    "checkpoint",
    "result",
    "symmetry",
    "initialization",
    "architecture_modified",
    "ed_accessed",
    "ed_used_for_gradient",
    "heldout_or_beyond_used_for_structure_selection",
    "ground_gates",
    "tower_gates",
    "resource_profile",
    "gates",
    "slurm",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": "challenge-15-route-d-plus-scalable-seed-v1"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "n_electrons": {"type": "integer", "minimum": 7},
    "two_q": {"type": "integer", "minimum": 18},
    "seed": {"type": "integer", "minimum": 0},
    "architecture_freeze": {"$ref": "#/$defs/artifact"},
    "calibration": {"$ref": "#/$defs/artifact"},
    "size_architecture": {"$ref": "#/$defs/artifact"},
    "checkpoint": {"$ref": "#/$defs/artifact"},
    "result": {"$ref": "#/$defs/artifact"},
    "symmetry": {"$ref": "#/$defs/artifact"},
    "initialization": {"const": "random-identity-nearby"},
    "architecture_modified": {"const": false},
    "ed_accessed": {"const": false},
    "ed_used_for_gradient": {"const": false},
    "heldout_or_beyond_used_for_structure_selection": {"const": false},
    "ground_gates": {"$ref": "#/$defs/gates"},
    "tower_gates": {"$ref": "#/$defs/gates"},
    "resource_profile": {
      "type": "object",
      "required": [
        "wall_seconds",
        "coordinate_backend",
        "n_electrons",
        "two_q",
        "updates",
        "chains",
        "samples_per_update",
        "final_samples_per_chain",
        "ground_ess_per_second",
        "tower_ess_per_second"
      ]
    },
    "gates": {"$ref": "#/$defs/gates"},
    "slurm": {"$ref": "#/$defs/slurm"},
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 2},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "boolean"}
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "cluster", "cuda_visible_devices"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "cuda_visible_devices": {"type": "string", "minLength": 1}
      }
    }
  }
}
